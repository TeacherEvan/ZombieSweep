{
  "name": "zombiesweep",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "multiplayer:server": "node server/multiplayer-server.mjs",
    "test": "vitest run",
    "test:3d": "vitest run --config vitest.config.3d.ts",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.171.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.4",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "ws": "^8.20.0"
  }
}
